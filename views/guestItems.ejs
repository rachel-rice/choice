<h2 id="listTitle"></h2>

<ul id="itemsContainer" class="list-group"></ul>

<form id="addItemForm">

  <input 
    type="text" 
    id="itemName"
    placeholder="Add item"
    required
  >
  <input
    type="text"
    id="itemDescription"
    placeholder="Description (optional)"
  >
  <button type="submit">Add</button>

</form>


<script>
  window.GUEST_LIST_ID = "<%= listId %>";
</script>

<script src="/js/guestItems.js"></script>