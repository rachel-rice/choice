<!-- Guest Random Pick -->
<div class="container">
<h2 class="mb-4 text-center text-md-start">Pick One</h2>

<div class="row g-3">

  <div class="text-center mb-5">
    <h4 class="fw-light text-muted mb-4">Click to pick a random item</h4>
  </div>

   <div class="row mb-5 justify-content-center">
    <div class="col-md-6 text-center">
      <h3 id="listTitle" class="mb-3"></h3>
     
        <button type="button" id="randomPickBtn" class="btn btn-outline-dark btn-standard">
          <i class="bi bi-shuffle me-1"></i>Pick
        </button>
    
      <h2 id="randomResult" class="mt-2 text-primary">
        <span id="randomName"></span>
      </h2>

      <p id="randomDescription"></p>
    </div>
  </div> 

  <!-- Guest Add New Item Card -->
  <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
    <div class="card add-card shadow-sm h-100 text-center d-flex align-items-center justify-content-center"
         style="cursor: pointer;"
         data-bs-toggle="modal"
         data-bs-target="#addItemModal">
      <div class="card-body d-flex flex-column align-items-center justify-content-center">
        <div class="display-4 text-muted mb-2">⊕</div>
        <h6 class="fw-bold mb-1">Add New Item</h6>
        <small class="text-muted">Add an item to this list</small>
      </div>
    </div>
  </div>

<ul id="itemsContainer" class="row g-3"></ul>

