<div class="container">
<h2 class="mb-4 text-center text-md-start">Pick One</h2>

<div class="row g-3">

  <div class="text-center mb-5">
    <h4 class="fw-light text-muted mb-4">Click to pick a random item</h4>
  </div>

   <div class="row mb-5 justify-content-center">
    <div class="col-md-6 text-center">
      <h3 id="listTitle" class="mb-3"></h3>
     
        <button type="button" id="randomPickBtn" class="btn btn-outline-dark btn-standard">
          <i class="bi bi-shuffle me-1"></i>Pick
        </button>
    
      <h2 id="randomResult" class="mt-2 text-primary"></h2>
      <p id="randomDescription"></p>
    </div>
  </div> 

<ul id="itemsContainer" class="list-group"></ul>

<form id="addItemForm">

  <input 
    type="text" 
    id="itemName"
    placeholder="Add item"
    required
  >
  <input
    type="text"
    id="itemDescription"
    placeholder="Description (optional)"
  >
  <button type="submit">Add</button>

</form>


<script>
  window.GUEST_LIST_ID = "<%= listId %>";
</script>

<% if (user) { %>
  <script src="/js/script.js"></script>
<% } %>

<script src="/js/guestItems.js"></script>